{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AntifyBot",
  "version": "1.2.0",
  "identifier": "works.antifybot.rs",
  "build": {
    "frontendDist": "dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.3"
    }
  }
}
